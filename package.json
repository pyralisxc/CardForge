{
  "name": "cardforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "next dev -p 9002 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "architecture:check": "node scripts/check-architecture.mjs",
    "architecture:changed": "node scripts/check-architecture.mjs --changed",
    "architecture:report": "node scripts/check-architecture.mjs --report",
    "migrations:check": "node scripts/check-migration-safety.mjs",
    "brand:export": "node scripts/export-brand-assets.mjs",
    "test": "npm run test:product && npm run test:infrastructure",
    "test:product": "vitest run",
    "test:infrastructure": "vitest run --config vitest.infrastructure.config.ts",
    "test:inventory": "node scripts/report-test-inventory.mjs",
    "test:watch": "vitest",
    "verify:affected": "npm run verify:focused",
    "verify:focused": "node scripts/report-affected-verification.mjs --run",
    "verify:full": "npm run lint && npm run typecheck && npm run test:product && npm run test:infrastructure && npm run architecture:check && npm run migrations:check && npm run build",
    "smoke:golden": "playwright test --grep @golden --workers=1",
    "smoke:hosted": "playwright test --config playwright.hosted.config.ts --workers=1",
    "smoke:ui": "playwright test --workers=1",
    "smoke:scale": "playwright test artifact-scale-performance.spec.ts --workers=1",
    "health:production": "node scripts/check-production-health.mjs",
    "pipeline:sync-defaults": "node scripts/sync-pipeline-defaults.mjs"
  },
  "dependencies": {
    "@clerk/mcp-tools": "^0.6.0",
    "@clerk/nextjs": "^7.8.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sparticuz/chromium": "149.0.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-color": "^3.30.5",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-text-style": "^3.23.4",
    "@tiptap/extension-underline": "^3.23.4",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@zip.js/zip.js": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "mcp-handler": "^2.1.1",
    "nanoid": "^5.0.7",
    "next": "^16.3.3",
    "papaparse": "5.7.0",
    "posthog-js": "^1.422.5",
    "puppeteer-core": "^25.9.0",
    "qrcode.react": "4.2.0",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.4",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.24",
    "@next/eslint-plugin-next": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "qs": "6.16.0",
    "dompurify": "3.4.13",
    "brace-expansion@1.1.16": "1.1.18",
    "js-yaml": "5.2.3",
    "launch-editor": "2.14.1",
    "postcss": {
      ".": "$postcss",
      "nanoid": "3.3.18"
    },
    "vite": "7.3.6"
  }
}
