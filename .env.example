NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Configure social sign-in providers in the Clerk Dashboard:
# Google, Apple, Microsoft, GitHub, and email are recommended for launch.

# Stripe Checkout subscriptions. Stripe can show Apple Pay / Google Pay in hosted Checkout
# when payment methods are enabled, the app is served over HTTPS, and the domain is registered.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_CREATOR_PASS_PRICE_ID=
STRIPE_SUPPORT_MONTHLY_1_PRICE_ID=
STRIPE_SUPPORT_MONTHLY_5_PRICE_ID=
STRIPE_SUPPORT_MONTHLY_10_PRICE_ID=
STRIPE_SUPPORT_MONTHLY_20_PRICE_ID=
STRIPE_SUPPORT_CURRENCY=usd
STRIPE_SUPPORT_PORTAL_URL=
# Canonical app URL for metadata, robots/sitemap, and Stripe return URLs.
# For production Vercel, use the custom production domain, not Supabase or a preview URL.
NEXT_PUBLIC_APP_URL=https://cardforges.com
# Stripe webhook endpoint: /api/billing/webhook
# Listen for checkout.session.completed and customer.subscription.* events.
STRIPE_WEBHOOK_SECRET=

# Transactional email readiness. Owner Console still controls the human support
# inbox; keep the Resend API key server-only.
RESEND_API_KEY=
CARDFORGE_EMAIL_FROM=
CARDFORGE_EMAIL_REPLY_TO=

# Optional entitlement allowlists for manual access support.
# These unlock clean exports for signed-in Clerk accounts only.
CARDFORGE_PAID_ACCOUNT_EMAILS=
CARDFORGE_DEV_ACCOUNT_EMAILS=
CARDFORGE_OWNER_ACCOUNT_EMAILS=

# Optional validation override. Local development defaults to dev; production defaults to free.
NEXT_PUBLIC_CARDFORGE_ACCESS_MODE=
CARDFORGE_ACCESS_MODE=

# Keep false/blank for hosted production unless intentionally editing shipped libraries.

# Server-only Supabase database and public-read Storage for shared production state.
# Keep the service-role key out of client components and NEXT_PUBLIC variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Extended Developer Cockpit lanes remain unavailable to non-owner developers
# until updated contribution terms/privacy are published and the release gate is approved.
CARDFORGE_EXTENDED_CONTRIBUTIONS_ENABLED=false

# Native CardForge marketing delivery. Meta owns Facebook/Instagram account
# authorization; CardForge owns strategy, approval, scheduling, and delivery history.
# Use the exact reviewed Graph API version configured for the Meta app.
CARDFORGE_META_APP_ID=
CARDFORGE_META_APP_SECRET=
# Facebook Login for Business configuration ID containing the reviewed permissions.
CARDFORGE_META_LOGIN_CONFIGURATION_ID=
CARDFORGE_META_GRAPH_API_VERSION=
CARDFORGE_META_PAGE_ID=
# Base64-encoded 32-byte AES key. Never expose this or provider tokens to the browser.
CARDFORGE_SOCIAL_TOKEN_ENCRYPTION_KEY=
# Shared bearer secret used only by the Supabase Cron -> CardForge dispatcher call.
CARDFORGE_MARKETING_DISPATCH_SECRET=
# Keep false until Meta OAuth, a harmless publication, retry behavior, and Cron are verified.
CARDFORGE_META_PUBLISHING_ENABLED=false

# Organic measurement. Google owns acquisition/search reporting, PostHog owns
# anonymous allow-listed interaction events, and CardForge owns
# campaign definitions plus the owner-only reporting composition.
# Publish the current privacy disclosure before enabling browser collection.
NEXT_PUBLIC_CARDFORGE_ANALYTICS_ENABLED=false
NEXT_PUBLIC_CARDFORGE_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CARDFORGE_POSTHOG_KEY=
NEXT_PUBLIC_CARDFORGE_POSTHOG_HOST=https://us.i.posthog.com
CARDFORGE_GOOGLE_ANALYTICS_PROPERTY_ID=
CARDFORGE_GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Store the PEM with escaped newlines (\n) in hosted environment settings.
CARDFORGE_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
CARDFORGE_GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:cardforges.com
# Personal key must be server-only and limited to Query Read for this project.
CARDFORGE_POSTHOG_PERSONAL_API_KEY=
CARDFORGE_POSTHOG_PROJECT_ID=
CARDFORGE_POSTHOG_APP_HOST=https://us.posthog.com
